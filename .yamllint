---
extends: default

ignore: |
  .venv/
  .ansible/
  .molecule/
  # An ansible-vault file is ciphertext with a header line, not YAML.
  inventories/*/group_vars/**/vault.yml

rules:
  line-length:
    max: 120
    level: warning
  truthy:
    allowed-values: ['true', 'false']
    check-keys: false
  comments:
    min-spaces-from-content: 1
  # ansible-lint requires this rule to be disabled
  comments-indentation: false
  braces:
    max-spaces-inside: 1
  octal-values:
    forbid-implicit-octal: true
    forbid-explicit-octal: true
