# Ansible
*.retry
.vault_pass
*.log

# Collections installed from requirements.yml (collections_path in ansible.cfg).
# They are dependencies, not source: CI reinstalls them from requirements.yml.
.ansible/

# Lab — the public key is copied into the build context, never committed
lab/authorized_keys

# Downloaded artifacts
*.tar.gz
*.tgz
*.jar

# Python / molecule
.venv/
__pycache__/
*.pyc
.molecule/

# Editors
.idea/
.vscode/
*.swp

# Personal working notes, never published
notes/
*.local.md

# The private certificate authority. A CA key in a public repository signs
# certificates for anyone who clones it.
.tls/
