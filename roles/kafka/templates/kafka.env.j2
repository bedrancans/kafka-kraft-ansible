{{ ansible_managed | comment }}
# Read by kafka.service through EnvironmentFile.
# kafka-server-start.sh picks these up before launching the JVM.

JAVA_HOME={{ kafka_java_home }}

# Fixed minimum and maximum: letting the heap grow means the JVM spends time
# resizing it, and a heap that can grow can also surprise the page cache.
KAFKA_HEAP_OPTS=-Xms{{ kafka_heap_size }} -Xmx{{ kafka_heap_size }}

KAFKA_JVM_PERFORMANCE_OPTS={{ kafka_jvm_opts }}

# Where the broker writes its own log4j output (not the message data).
LOG_DIR={{ kafka_app_log_dir }}
