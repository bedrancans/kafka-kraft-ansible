{{ ansible_managed | comment }}
#
# Rendered from roles/kafka/templates/server.properties.j2
# Do not edit on the host: the next Ansible run overwrites it.

############################# Node identity #############################

process.roles={{ kafka_process_roles }}
node.id={{ kafka_node_id }}

{% if 'controller' in kafka_process_roles %}
############################# KRaft quorum #############################

# Static voter list: every node must see the exact same string here, or the
# quorum never forms. Built from the kafka_controllers inventory group, so
# adding a controller is an inventory edit and nothing else.
controller.quorum.voters={% for host in groups['kafka_controllers'] -%}
{{ hostvars[host].kafka_node_id }}@{{ hostvars[host].kafka_controller_host }}:{{ kafka_controller_port }}
{%- if not loop.last %},{% endif %}
{%- endfor %}

{% endif %}
############################# Listeners #############################
#
# Rendered from kafka_listeners. One address can never serve both the cluster
# and the outside world, so each listener states what it advertises:
# its own hostname, whatever a client outside reaches it as, or nothing at all
# for the controller listener, which Kafka refuses to advertise.
#
{% set active = [] %}
{% for listener in kafka_listeners %}
{%   if kafka_process_roles.split(',') | select('in', listener.roles) | list | length > 0 %}
{%     set _ = active.append(listener) %}
{%   endif %}
{% endfor %}
listeners={% for l in active %}{{ l.name }}://:{{ l.port }}{{ "," if not loop.last }}{% endfor %}

{% set advertised = active | rejectattr('advertise', 'equalto', 'none') | list %}
{% if advertised | length > 0 %}
advertised.listeners={% for l in advertised %}
{{- l.name }}://
{{- kafka_internal_host if l.advertise == 'internal' else kafka_external_advertised_host }}:
{{- l.port if l.advertise == 'internal' else kafka_external_advertised_port }}
{{- "," if not loop.last }}{% endfor %}

{% endif %}
listener.security.protocol.map={% for l in active %}{{ l.name }}:{{ l.protocol }}{{ "," if not loop.last }}{% endfor %}

{% if 'broker' in kafka_process_roles %}
inter.broker.listener.name={{ kafka_inter_broker_listener }}
{% endif %}
{% if 'controller' in kafka_process_roles %}
# First entry is the one used for outbound connections, which is what makes a
# two-step listener migration possible.
controller.listener.names={{ kafka_controller_listener_names | join(',') }}
{% endif %}
{% if kafka_security_enabled | bool %}

############################# TLS #############################
#
# PEM rather than JKS: Kafka has read it directly since 2.7, which removes
# keytool, a store password, and a conversion step whose failures are opaque.
# The keystore file holds the certificate followed by its private key.
#
ssl.keystore.type=PEM
ssl.keystore.location={{ kafka_tls_keystore }}
ssl.truststore.type=PEM
ssl.truststore.location={{ kafka_tls_truststore }}

# Brokers present a certificate to the controller quorum, so the peer's
# identity there is its subject. Without a mapping rule the principal is the
# whole DN, and every ACL and super.users entry has to spell it out.
ssl.principal.mapping.rules={{ kafka_ssl_principal_mapping }}

# Required on the controller listener: mutual TLS is what authenticates a
# broker to the quorum, since SCRAM credentials live in the metadata the
# quorum itself manages — which would make them a prerequisite for reaching
# the thing that stores them.
ssl.client.auth=required
ssl.endpoint.identification.algorithm=https

############################# SASL #############################

sasl.enabled.mechanisms={{ kafka_sasl_mechanism }}
sasl.mechanism.inter.broker.protocol={{ kafka_sasl_mechanism }}

# A JAAS entry is required for every listener that speaks SASL, not only the
# one carrying inter-broker traffic: a SASL listener without one refuses to
# start with "Could not find a 'KafkaServer' entry in the JAAS configuration".
# The credential is the broker's own, used both to accept connections and to
# authenticate when it dials another broker.
{% for l in active if l.protocol.startswith('SASL') %}
listener.name.{{ l.name | lower }}.{{ kafka_sasl_mechanism | lower }}.sasl.jaas.config=\
org.apache.kafka.common.security.scram.ScramLoginModule required \
username="{{ inventory_hostname }}" \
password="{{ kafka_broker_password }}";
{% endfor %}
{% endif %}
{% if kafka_authorizer_enabled | bool %}

############################# Authorization #############################
#
# Anything without a matching ACL is denied. The brokers are super users
# because the authorizer applies to them too, and a broker that cannot manage
# the cluster is a broker that cannot start.
#
authorizer.class.name={{ kafka_authorizer_class }}
super.users={{ kafka_super_users | join(';') }}
allow.everyone.if.no.acl.found={{ kafka_allow_everyone_if_no_acl_found | lower }}
{% endif %}

############################# Storage #############################

log.dirs={{ kafka_data_dir }}
num.recovery.threads.per.data.dir=2

############################# Durability #############################
#
# Three replicas with two required in sync: the cluster survives losing one
# broker without data loss, and refuses writes after losing two. Refusing is
# the point — the alternative is silently accepting data it cannot protect.
#
default.replication.factor={{ kafka_default_replication_factor }}
min.insync.replicas={{ kafka_min_insync_replicas }}
num.partitions={{ kafka_num_partitions }}

# Kafka's own bookkeeping topics need the same durability as user data.
offsets.topic.replication.factor={{ kafka_offsets_topic_replication_factor }}
transaction.state.log.replication.factor={{ kafka_transaction_state_log_replication_factor }}
transaction.state.log.min.isr={{ kafka_transaction_state_log_min_isr }}

# A typo in a client should not create a single-replica topic in production.
auto.create.topics.enable={{ kafka_auto_create_topics_enable | lower }}

############################# Retention #############################

log.retention.hours={{ kafka_log_retention_hours }}
log.segment.bytes={{ kafka_log_segment_bytes }}
log.retention.check.interval.ms={{ kafka_log_retention_check_interval_ms }}

############################# Threads and sockets #############################

num.network.threads={{ kafka_num_network_threads }}
num.io.threads={{ kafka_num_io_threads }}
socket.send.buffer.bytes={{ kafka_socket_send_buffer_bytes }}
socket.receive.buffer.bytes={{ kafka_socket_receive_buffer_bytes }}
socket.request.max.bytes={{ kafka_socket_request_max_bytes }}
