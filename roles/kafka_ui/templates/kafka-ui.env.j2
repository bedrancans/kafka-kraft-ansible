{{ ansible_managed | comment }}
# Read by kafka-ui.service through EnvironmentFile.
# Kafka UI maps every Spring property to an environment variable, which is why
# the configuration looks like this instead of a YAML file.

SERVER_PORT={{ kafka_ui_port }}
SERVER_ADDRESS={{ kafka_ui_bind_address }}

# Managed by Ansible, so the UI must not write its own configuration.
DYNAMIC_CONFIG_ENABLED={{ kafka_ui_dynamic_config_enabled | lower }}

############################# Cluster #############################

KAFKA_CLUSTERS_0_NAME={{ kafka_ui_cluster_display_name }}
# Derived from the kafka_brokers inventory group. Adding a broker changes this
# line without anyone editing it.
KAFKA_CLUSTERS_0_BOOTSTRAPSERVERS={{ kafka_bootstrap_servers }}

{% if kafka_ui_security_enabled | bool %}
############################# Cluster credentials #############################
#
# Anything under KAFKA_CLUSTERS_0_PROPERTIES_ is handed straight to the Kafka
# client, with underscores becoming dots. That is how a PEM truststore gets
# configured here without Kafka UI needing to know about PEM at all.
#
KAFKA_CLUSTERS_0_PROPERTIES_SECURITY_PROTOCOL=SASL_SSL
KAFKA_CLUSTERS_0_PROPERTIES_SASL_MECHANISM={{ kafka_ui_sasl_mechanism }}
KAFKA_CLUSTERS_0_PROPERTIES_SASL_JAAS_CONFIG=org.apache.kafka.common.security.scram.ScramLoginModule required username="{{ kafka_ui_sasl_username }}" password="{{ kafka_ui_sasl_password }}";
KAFKA_CLUSTERS_0_PROPERTIES_SSL_TRUSTSTORE_TYPE=PEM
KAFKA_CLUSTERS_0_PROPERTIES_SSL_TRUSTSTORE_LOCATION={{ kafka_ui_truststore }}

{% endif %}
############################# Discovered components #############################
#
# Everything below appears only when the matching inventory group has a host.
# That is the whole trick behind adding a component without touching the
# cluster: deploy the component, re-run this role, and the UI picks it up.
# The brokers are never involved.
#
{% if groups['schema_registry'] | default([]) | length > 0 %}
KAFKA_CLUSTERS_0_SCHEMAREGISTRY=http://{{ groups['schema_registry'][0] }}:{{ schema_registry_port }}
{% else %}
# schema_registry group is empty — no Schema Registry configured.
{% endif %}
{% if groups['kafka_connect'] | default([]) | length > 0 %}
KAFKA_CLUSTERS_0_KAFKACONNECT_0_NAME=connect
KAFKA_CLUSTERS_0_KAFKACONNECT_0_ADDRESS=http://{{ groups['kafka_connect'][0] }}:{{ kafka_connect_port }}
{% else %}
# kafka_connect group is empty — no Kafka Connect configured.
{% endif %}

############################# JVM #############################

JAVA_HOME={{ kafka_ui_java_home }}
JAVA_OPTS=-Xms{{ kafka_ui_heap_size }} -Xmx{{ kafka_ui_heap_size }} {{ kafka_ui_jvm_opts }}
